---
interface Props {
  class?: string;
  size?: number | string;
}

const { class: className = "w-9 h-9", size } = Astro.props;
---

<svg 
  xmlns="http://www.w3.org/2000/svg" 
  viewBox="0 0 512 512" 
  role="img" 
  aria-label="Metadata Stripper logo"
  class={className}
  width={size}
  height={size}
>
  <title>Metadata Stripper</title>
  <desc>Minimal shield, metadata tag and removal mark icon</desc>
  <path d="M256 78L388 130V238c0 92-53 160-132 200-79-40-132-108-132-200V130z" fill="none" class="logo-primary-stroke" stroke-width="24" stroke-linejoin="round"/>
  <path d="M183 171h95l48 48v79l-87 87-82-82V197c0-14 12-26 26-26z" class="logo-primary-fill"/>
  <circle cx="193" cy="207" r="12" class="logo-cutout-fill"/>
  <rect x="190" y="248" width="86" height="13" rx="6.5" class="logo-cutout-fill"/>
  <rect x="190" y="278" width="64" height="13" rx="6.5" class="logo-cutout-fill"/>
  <path d="M158 353L348 163" fill="none" class="logo-accent-stroke" stroke-width="25" stroke-linecap="round"/>
  <rect x="331" y="252" width="25" height="25" rx="4" class="logo-primary-fill"/>
  <rect x="360" y="225" width="18" height="18" rx="3" class="logo-primary-fill"/>
  <rect x="365" y="283" width="20" height="20" rx="3" class="logo-primary-fill"/>
  <rect x="335" y="309" width="15" height="15" rx="3" class="logo-accent-fill"/>
  <rect x="382" y="263" width="13" height="13" rx="3" class="logo-accent-fill"/>
</svg>
