---
---
<footer class="w-full border-t border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] py-12 px-4 sm:px-6 text-xs text-[#888888] dark:text-[#a1a1a1] transition-colors duration-200">
  <div class="max-w-6xl mx-auto space-y-8">
    
    <!-- Top Footer Row: Links -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
      
      <!-- Brand Column -->
      <div class="space-y-3">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded bg-[#171717] dark:bg-white text-white dark:text-[#171717] flex items-center justify-center font-bold text-xs">
            🛡️
          </div>
          <span class="font-semibold text-sm text-[#171717] dark:text-white font-sans">
            Metadata Remover
          </span>
        </div>
        <p class="text-xs text-[#888888] dark:text-[#a1a1a1] leading-relaxed font-sans">
          The 100% client-side privacy tool to strip EXIF data, GPS coordinates, camera specs, and creation history from photos, PDFs, and videos.
        </p>
        <div class="flex items-center gap-2 pt-1 font-mono text-[11px] text-[#10b981]">
          <span class="w-2 h-2 rounded-full bg-[#10b981] animate-pulse"></span>
          <span>Files stay on your local device</span>
        </div>
      </div>

      <!-- Tools Column -->
      <div class="space-y-3 font-sans">
        <h4 class="text-xs font-semibold text-[#171717] dark:text-white uppercase tracking-wider font-mono">Tools</h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/" class="hover:text-[#171717] dark:hover:text-white transition-colors">Image EXIF Remover</a>
          </li>
          <li>
            <a href="/pdf-metadata-remover" class="hover:text-[#171717] dark:hover:text-white transition-colors">PDF Metadata Remover</a>
          </li>
          <li>
            <a href="/video-metadata-remover" class="hover:text-[#171717] dark:hover:text-white transition-colors">Video Metadata Remover</a>
          </li>
        </ul>
      </div>

      <!-- Legal & Company Column -->
      <div class="space-y-3 font-sans">
        <h4 class="text-xs font-semibold text-[#171717] dark:text-white uppercase tracking-wider font-mono">Company & Privacy</h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/about" class="hover:text-[#171717] dark:hover:text-white transition-colors">About Us</a>
          </li>
          <li>
            <a href="/privacy-policy" class="hover:text-[#171717] dark:hover:text-white transition-colors">Privacy Policy</a>
          </li>
          <li>
            <a href="/terms-and-conditions" class="hover:text-[#171717] dark:hover:text-white transition-colors">Terms & Conditions</a>
          </li>
          <li>
            <a href="/contact" class="hover:text-[#171717] dark:hover:text-white transition-colors">Contact Us</a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright Bar -->
    <div class="border-t border-[#ebebeb] dark:border-[#262626] pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-[11px]">
      <div>
        &copy; {new Date().getFullYear()} metadatastripper.com • All Rights Reserved.
      </div>
      <div class="flex items-center gap-4 text-[#888888] dark:text-[#a1a1a1]">
        <span>100% Free & Private</span>
        <span>•</span>
        <span>Client-Side Wasm Engine</span>
      </div>
    </div>

  </div>
</footer>
