---
---
<section id="tool" class="max-w-4xl mx-auto px-4 sm:px-6 pb-16">
  <div class="bg-white dark:bg-[#111111] rounded-2xl border border-[#ebebeb] dark:border-[#262626] shadow-xl overflow-hidden card-elevated transition-colors duration-200">
    
    <!-- Step Progress Indicator -->
    <div class="border-b border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#171717] px-4 py-3 sm:px-6 flex items-center justify-between overflow-x-auto text-xs font-mono">
      <div class="flex items-center gap-4 sm:gap-6 min-w-max">
        <span id="pdf-step-1-badge" class="flex items-center gap-1.5 text-[#171717] dark:text-white font-semibold">
          <span class="w-5 h-5 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] flex items-center justify-center text-[10px]">1</span>
          Upload
        </span>
        <span class="text-[#ebebeb] dark:text-[#333333]">→</span>
        <span id="pdf-step-2-badge" class="flex items-center gap-1.5 text-[#888888]">
          <span class="w-5 h-5 rounded-full bg-[#f5f5f5] dark:bg-[#262626] text-[#888888] flex items-center justify-center text-[10px]">2</span>
          Scan &amp; Inspect
        </span>
        <span class="text-[#ebebeb] dark:text-[#333333]">→</span>
        <span id="pdf-step-3-badge" class="flex items-center gap-1.5 text-[#888888]">
          <span class="w-5 h-5 rounded-full bg-[#f5f5f5] dark:bg-[#262626] text-[#888888] flex items-center justify-center text-[10px]">3</span>
          Remove &amp; Verify
        </span>
        <span class="text-[#ebebeb] dark:text-[#333333]">→</span>
        <span id="pdf-step-4-badge" class="flex items-center gap-1.5 text-[#888888]">
          <span class="w-5 h-5 rounded-full bg-[#f5f5f5] dark:bg-[#262626] text-[#888888] flex items-center justify-center text-[10px]">4</span>
          Download
        </span>
      </div>
      <span class="hidden md:inline-block text-[#888888] dark:text-[#666666]">Processed directly in your browser</span>
    </div>

    <!-- 1. UPLOAD STATE (Initial Server Rendered DOM) -->
    <div id="pdf-state-upload" class="p-6 sm:p-10 text-center space-y-6">
      
      <!-- Speed Benefit Sub-header -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#fafafa] dark:bg-[#171717] border border-[#ebebeb] dark:border-[#262626] text-xs font-mono text-[#4d4d4d] dark:text-[#a1a1a1]">
        <span>⚡ Privacy-focused PDF processing</span>
        <span class="text-[#888888] dark:text-[#666666]">•</span>
        <span class="text-[#888888] dark:text-[#a1a1a1] font-sans">No upload. No server waiting. Processed on your device.</span>
      </div>

      <div 
        id="pdf-drop-zone" 
        class="border-2 border-dashed border-[#a1a1a1]/40 dark:border-[#404040] hover:border-[#0070f3] dark:hover:border-[#0070f3] bg-[#fafafa] dark:bg-[#171717] hover:bg-[#0070f3]/5 rounded-xl p-8 sm:p-12 transition-all duration-200 cursor-pointer group flex flex-col items-center justify-center space-y-4"
      >
        <input 
          type="file" 
          id="pdf-file-input" 
          class="hidden" 
          accept=".pdf,application/pdf" 
        />
        
        <div class="w-16 h-16 rounded-full bg-white dark:bg-[#262626] border border-[#ebebeb] dark:border-[#333333] shadow-sm flex items-center justify-center text-[#171717] dark:text-white group-hover:scale-110 group-hover:border-[#0070f3] group-hover:text-[#0070f3] transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
            <polyline points="14 2 14 8 20 8"/>
          </svg>
        </div>

        <div class="space-y-1">
          <p class="text-base sm:text-lg font-semibold text-[#171717] dark:text-white">
            Drag and drop your PDF here, or <span class="text-[#0070f3] underline underline-offset-2">browse</span>
          </p>
          <p class="text-xs text-[#888888] dark:text-[#a1a1a1] font-mono">
            Supported Formats: PDF (.pdf) • Max Size: 100MB
          </p>
        </div>

        <!-- Primary CTA Button -->
        <button 
          type="button" 
          id="btn-choose-pdf"
          class="px-6 py-3 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] font-medium text-sm hover:bg-[#333333] dark:hover:bg-[#e5e5e5] active:scale-98 transition-all shadow-md flex items-center gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
          Choose PDF
        </button>
      </div>

      <!-- Format Redirection / User-friendly Error Alert Banner -->
      <div id="pdf-error-banner" class="hidden p-4 sm:p-5 rounded-xl border transition-all text-left">
        <span id="pdf-error-message"></span>
      </div>

      <!-- Quick Tool Switcher Links -->
      <div class="flex flex-wrap items-center justify-center gap-2 pt-1 text-xs font-mono text-[#888888] dark:text-[#a1a1a1]">
        <span>Looking for another format?</span>
        <a href="/video-metadata-remover" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-[#fafafa] dark:bg-[#171717] border border-[#ebebeb] dark:border-[#262626] text-[#0070f3] hover:underline">
          🎥 Video Remover
        </a>
        <a href="/" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-[#fafafa] dark:bg-[#171717] border border-[#ebebeb] dark:border-[#262626] text-[#0070f3] hover:underline">
          📷 Image Tool
        </a>
      </div>

      <!-- Subtle Trust Indicators Row -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 text-left">
        <div class="p-3 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#171717] space-y-0.5">
          <div class="flex items-center gap-1.5 text-xs font-semibold text-[#171717] dark:text-white">
            <span>🔒</span> Private
          </div>
          <p class="text-[11px] text-[#888888] dark:text-[#a1a1a1] font-sans leading-tight">Your PDF stays on your device</p>
        </div>

        <div class="p-3 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#171717] space-y-0.5">
          <div class="flex items-center gap-1.5 text-xs font-semibold text-[#171717] dark:text-white">
            <span>⚡</span> Fast
          </div>
          <p class="text-[11px] text-[#888888] dark:text-[#a1a1a1] font-sans leading-tight">No upload or server processing</p>
        </div>

        <div class="p-3 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#171717] space-y-0.5">
          <div class="flex items-center gap-1.5 text-xs font-semibold text-[#171717] dark:text-white">
            <span>✓</span> Verified
          </div>
          <p class="text-[11px] text-[#888888] dark:text-[#a1a1a1] font-sans leading-tight">The cleaned PDF is rescanned after removal</p>
        </div>
      </div>

    </div>

    <!-- 2. SCAN & INSPECT STATE (Populated dynamically on PDF selection) -->
    <div id="pdf-state-scan" class="hidden p-6 sm:p-8 space-y-6"></div>

    <!-- 3. VERIFICATION & DOWNLOAD STATE (Populated dynamically after PDF removal) -->
    <div id="pdf-state-verify" class="hidden p-6 sm:p-8 space-y-6"></div>

  </div>
</section>

<!-- Interactive Client-side Script for PDF Processor -->
<script>
  import { scanPdfMetadata, removePdfMetadata, verifyCleanPdf } from '../utils/pdfMetadataEngine.js';

  let currentPdfFile = null;
  let scanPdfResults = null;
  let cleanedPdfBlob = null;

  // DOM Elements
  const pdfDropZone = document.getElementById('pdf-drop-zone');
  const pdfFileInput = document.getElementById('pdf-file-input');
  const btnChoosePdf = document.getElementById('btn-choose-pdf');
  const pdfStateUpload = document.getElementById('pdf-state-upload');
  const pdfStateScan = document.getElementById('pdf-state-scan');
  const pdfStateVerify = document.getElementById('pdf-state-verify');

  const pdfErrorBanner = document.getElementById('pdf-error-banner');
  const pdfErrorMessage = document.getElementById('pdf-error-message');

  const pdfStep1Badge = document.getElementById('pdf-step-1-badge');
  const pdfStep2Badge = document.getElementById('pdf-step-2-badge');
  const pdfStep3Badge = document.getElementById('pdf-step-3-badge');
  const pdfStep4Badge = document.getElementById('pdf-step-4-badge');

  // Trigger File Picker
  btnChoosePdf?.addEventListener('click', () => pdfFileInput.click());
  pdfDropZone?.addEventListener('click', (e) => {
    if (e.target !== btnChoosePdf) pdfFileInput.click();
  });

  // Drag & Drop Handlers
  pdfDropZone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    pdfDropZone.classList.add('border-[#0070f3]', 'bg-[#0070f3]/5');
  });
  pdfDropZone?.addEventListener('dragleave', () => {
    pdfDropZone.classList.remove('border-[#0070f3]', 'bg-[#0070f3]/5');
  });
  pdfDropZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    pdfDropZone.classList.remove('border-[#0070f3]', 'bg-[#0070f3]/5');
    if (e.dataTransfer.files && e.dataTransfer.files[0]) {
      handlePdfSelected(e.dataTransfer.files[0]);
    }
  });

  pdfFileInput?.addEventListener('change', (e) => {
    if (e.target.files && e.target.files[0]) {
      handlePdfSelected(e.target.files[0]);
    }
  });

  function showPdfRedirectBanner(type, fileName, targetUrl, targetName, icon) {
    if (!pdfErrorBanner) return;
    pdfErrorBanner.className = 'p-4 sm:p-5 rounded-xl bg-[#0070f3]/10 border border-[#0070f3] text-[#171717] dark:text-white text-xs font-mono text-left flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4';
    pdfErrorBanner.innerHTML = `
      <div class="flex items-start gap-3 min-w-0">
        <span class="text-2xl shrink-0">${icon}</span>
        <div class="space-y-1 min-w-0">
          <h4 class="font-bold text-sm text-[#0070f3]">${escapeHtml(targetName)} Detected</h4>
          <p class="text-[#4d4d4d] dark:text-[#a1a1a1] font-sans text-xs leading-relaxed">
            You selected <strong class="font-mono text-[#171717] dark:text-white truncate max-w-[200px] inline-block align-bottom">${escapeHtml(fileName)}</strong>. To remove metadata from ${type === 'video' ? 'video files' : 'images'}, use our dedicated tool.
          </p>
        </div>
      </div>
      <a href="${targetUrl}" class="px-5 py-2.5 rounded-full bg-[#0070f3] hover:bg-[#0761d1] text-white font-semibold font-sans text-xs shadow-md transition-all whitespace-nowrap shrink-0 w-full sm:w-auto text-center">
        Go to ${escapeHtml(targetName)} →
      </a>
    `;
    pdfErrorBanner.classList.remove('hidden');
  }

  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // PDF File Selection Handler
  async function handlePdfSelected(file) {
    if (pdfErrorBanner) pdfErrorBanner.classList.add('hidden');

    const ext = file.name.split('.').pop().toLowerCase();
    const isVideo = ['mp4', 'mov', 'm4v', 'webm', 'mkv', 'avi'].includes(ext) || file.type.startsWith('video/');
    const isImage = ['jpg', 'jpeg', 'png', 'webp', 'gif', 'heic'].includes(ext) || file.type.startsWith('image/');

    if (isVideo) {
      showPdfRedirectBanner('video', file.name, '/video-metadata-remover', 'Video Metadata Remover', '🎥');
      return;
    }
    if (isImage) {
      showPdfRedirectBanner('image', file.name, '/', 'Image Metadata Remover', '📷');
      return;
    }

    currentPdfFile = file;

    // Scan metadata
    scanPdfResults = await scanPdfMetadata(file);

    if (!scanPdfResults.success) {
      if (pdfErrorMessage) pdfErrorMessage.textContent = scanPdfResults.message || '⚠️ Error processing PDF file.';
      pdfErrorBanner.className = 'p-4 rounded-xl bg-[#f7d4d6] dark:bg-[#3f1315] border border-[#ee0000] text-[#c50000] dark:text-[#f87171] text-xs font-mono flex items-center gap-3 text-left';
      if (pdfErrorBanner) pdfErrorBanner.classList.remove('hidden');
      return;
    }

    updatePdfStepBadges(2);

    // Render PDF scan state dynamically
    renderPdfScanState(file, scanPdfResults);

    // Switch View
    pdfStateUpload.classList.add('hidden');
    pdfStateScan.classList.remove('hidden');
    pdfStateVerify.classList.add('hidden');
  }

  // Dynamically render PDF Scan State HTML
  function renderPdfScanState(file, results) {
    const sizeMb = (file.size / (1024 * 1024)).toFixed(2);

    pdfStateScan.innerHTML = `
      <!-- File Header Summary -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-4 rounded-xl bg-[#fafafa] dark:bg-[#171717] border border-[#ebebeb] dark:border-[#262626]">
        <div class="flex items-center gap-4 overflow-hidden">
          <div class="w-12 h-12 rounded-lg border border-[#ebebeb] dark:border-[#333333] bg-[#ee0000]/10 text-[#ee0000] flex-shrink-0 flex items-center justify-center font-bold text-sm font-mono">
            PDF
          </div>
          <div class="min-w-0">
            <h3 class="text-sm font-semibold text-[#171717] dark:text-white truncate">${escapeHtml(file.name)}</h3>
            <p class="text-xs font-mono text-[#888888] dark:text-[#a1a1a1] mt-0.5">PDF Document • ${sizeMb} MB</p>
          </div>
        </div>

        <button 
          id="btn-pdf-change-file" 
          class="text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white px-3 py-1.5 rounded-full border border-[#ebebeb] dark:border-[#333333] bg-[#111111] hover:bg-[#fafafa] dark:hover:bg-[#262626] transition-colors"
        >
          Change PDF
        </button>
      </div>

      <!-- Metadata Audit Card -->
      <div class="border border-[#ebebeb] dark:border-[#262626] rounded-xl p-5 bg-[#fafafa] dark:bg-[#171717] space-y-4">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
          <h4 class="text-xs font-mono uppercase tracking-wider text-[#888888] dark:text-[#a1a1a1] font-semibold">Detected PDF Document Metadata</h4>
          <span class="px-3 py-1 rounded-full bg-[#ee0000] text-white text-xs font-mono font-semibold">
            ${results.totalCount} Metadata Fields Detected
          </span>
        </div>

        ${!results.hasMetadata ? `
          <div class="p-4 rounded-lg bg-white dark:bg-[#111111] border border-[#ebebeb] dark:border-[#262626] text-xs font-mono text-[#888888]">
            ✓ No standard removable metadata fields detected in this PDF document.
          </div>
        ` : `
          <div class="border border-[#ebebeb] dark:border-[#262626] rounded-xl bg-white dark:bg-[#111111] overflow-hidden">
            <div class="flex items-center justify-between px-3 py-2 bg-[#fafafa] dark:bg-[#171717] border-b border-[#ebebeb] dark:border-[#262626] text-[11px] font-mono text-[#888888] dark:text-[#a1a1a1] sm:hidden">
              <span>Scroll table to view all columns</span>
              <span>→</span>
            </div>
            <div class="overflow-x-auto [webkit-overflow-scrolling:touch] w-full">
              <table class="w-full min-w-[500px] text-left text-xs font-mono">
                <thead class="bg-[#fafafa] dark:bg-[#171717] border-b border-[#ebebeb] dark:border-[#262626] text-[#888888] dark:text-[#a1a1a1]">
                  <tr>
                    <th class="px-3 py-2.5 font-medium">PDF Field</th>
                    <th class="px-3 py-2.5 font-medium hidden sm:table-cell">Internal Key</th>
                    <th class="px-3 py-2.5 font-medium">Detected Value</th>
                    <th class="px-3 py-2.5 font-medium text-right">Status</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-[#ebebeb] dark:divide-[#262626] text-[#171717] dark:text-white">
                  ${results.metadataList.map(item => `
                    <tr class="hover:bg-[#fafafa] dark:hover:bg-[#171717] transition-colors">
                      <td class="px-3 py-2.5 text-[#4d4d4d] dark:text-[#a1a1a1] font-semibold break-words max-w-[150px] sm:max-w-none">${escapeHtml(item.name)}</td>
                      <td class="px-3 py-2.5 text-[#888888] text-[10px] hidden sm:table-cell font-mono">${escapeHtml(item.key)}</td>
                      <td class="px-3 py-2.5 text-[#171717] dark:text-white break-all max-w-xs sm:max-w-md">${escapeHtml(item.value)}</td>
                      <td class="px-3 py-2.5 text-right font-medium text-[#10b981] whitespace-nowrap">Removable ✓</td>
                    </tr>
                  `).join('')}
                </tbody>
              </table>
            </div>
          </div>
        `}
      </div>

      <!-- Action Row -->
      <div class="pt-4 border-t border-[#ebebeb] dark:border-[#262626] flex items-center justify-between">
        <span class="text-xs text-[#888888] dark:text-[#a1a1a1] font-mono">
          All document metadata, author tags, and creation software history will be cleared.
        </span>

        <button 
          id="btn-remove-pdf-metadata"
          class="px-8 py-3 rounded-full bg-[#171717] dark:bg-white hover:bg-[#333333] dark:hover:bg-[#e5e5e5] text-white dark:text-[#171717] font-semibold text-sm shadow-md active:scale-98 transition-all flex items-center gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
          Remove PDF Metadata
        </button>
      </div>
    `;

    document.getElementById('btn-pdf-change-file')?.addEventListener('click', resetPdfToUploadState);
    document.getElementById('btn-remove-pdf-metadata')?.addEventListener('click', handleRemovePdfMetadata);
  }

  // Remove PDF Metadata Action
  async function handleRemovePdfMetadata() {
    if (!currentPdfFile) return;

    const btnRemovePdfMetadata = document.getElementById('btn-remove-pdf-metadata');
    if (btnRemovePdfMetadata) {
      btnRemovePdfMetadata.disabled = true;
      btnRemovePdfMetadata.innerHTML = `
        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-current" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Cleaning PDF...
      `;
    }

    updatePdfStepBadges(3);
    const startTime = performance.now();

    try {
      cleanedPdfBlob = await removePdfMetadata(currentPdfFile);
      const verifyReport = await verifyCleanPdf(cleanedPdfBlob, scanPdfResults.metadataList);
      const endTime = performance.now();
      const durationSeconds = ((endTime - startTime) / 1000).toFixed(2);

      const cleanUrl = URL.createObjectURL(cleanedPdfBlob);
      const parts = currentPdfFile.name.split('.');
      const ext = parts.pop();
      const cleanFileName = `${parts.join('.')}_clean.${ext}`;

      renderPdfVerifyState(verifyReport, durationSeconds, cleanUrl, cleanFileName);

      updatePdfStepBadges(4);
      pdfStateScan.classList.add('hidden');
      pdfStateVerify.classList.remove('hidden');
    } catch (err) {
      if (pdfErrorMessage) pdfErrorMessage.textContent = err.message || '⚠️ Failed to clean PDF metadata.';
      if (pdfErrorBanner) pdfErrorBanner.classList.remove('hidden');
      if (btnRemovePdfMetadata) {
        btnRemovePdfMetadata.disabled = false;
        btnRemovePdfMetadata.innerHTML = `Remove PDF Metadata`;
      }
    }
  }

  // Dynamically render PDF Verify State HTML
  function renderPdfVerifyState(report, durationSeconds, cleanUrl, cleanFileName) {
    pdfStateVerify.innerHTML = `
      <div class="p-4 rounded-xl ${report.verified ? 'bg-[#d1fae5] dark:bg-[#064e3b] border border-[#10b981] text-[#065f46] dark:text-[#a7f3d0]' : 'bg-[#ffefcf] dark:bg-[#2e1e05] border border-[#f5a623] text-[#ab570a] dark:text-[#fbbf24]'} flex items-center justify-between gap-3 flex-col sm:flex-row">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full ${report.verified ? 'bg-[#10b981]' : 'bg-[#f5a623]'} text-white flex items-center justify-center font-bold flex-shrink-0">
            ${report.verified ? '✓' : '⚠️'}
          </div>
          <div>
            <h4 class="text-sm font-semibold">${report.verified ? 'PDF Metadata Removed & Verified' : 'Some PDF fields remain'}</h4>
            <p class="text-xs opacity-90 mt-0.5 font-mono">
              ${report.verified ? 'Rescanned clean file: All document metadata cleared.' : 'Some internal PDF streams could not be completely cleared.'}
            </p>
          </div>
        </div>
        <div class="px-3 py-1.5 rounded-lg bg-white/70 dark:bg-black/40 border border-current/30 text-xs font-mono font-medium self-start sm:self-auto">
          ⚡ Processing time: ${durationSeconds}s
        </div>
      </div>

      <div class="border border-[#ebebeb] dark:border-[#262626] rounded-xl p-5 bg-[#fafafa] dark:bg-[#171717] space-y-4">
        <div class="flex items-center justify-between">
          <h4 class="text-xs font-mono uppercase tracking-wider text-[#888888] dark:text-[#a1a1a1]">PDF Verification Audit Report</h4>
          <span class="px-2.5 py-1 rounded-full ${report.verified ? 'bg-[#10b981]' : 'bg-[#f5a623]'} text-white text-xs font-mono font-bold">
            ${report.removedCount} / ${report.totalOriginal} Fields Cleared
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs font-mono">
          ${report.verificationItems.map(item => `
            <div class="flex items-center justify-between p-3 rounded-lg bg-white dark:bg-[#111111] border border-[#ebebeb] dark:border-[#262626]">
              <div>
                <span class="text-[#4d4d4d] dark:text-[#a1a1a1] block font-semibold">${escapeHtml(item.name)}</span>
                <span class="text-[10px] text-[#888888] font-mono">${escapeHtml(item.key)}</span>
              </div>
              <span class="${item.removed ? 'text-[#10b981]' : 'text-[#ee0000]'} font-semibold flex items-center gap-1">
                ${item.removed ? '✓ Cleared' : '⚠️ Remaining'}
              </span>
            </div>
          `).join('')}
        </div>
      </div>

      <div class="pt-4 border-t border-[#ebebeb] dark:border-[#262626] flex flex-col sm:flex-row items-center justify-between gap-4">
        <button 
          id="btn-pdf-another"
          class="w-full sm:w-auto px-6 py-3 rounded-full border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#171717] hover:bg-[#fafafa] dark:hover:bg-[#262626] text-[#171717] dark:text-white font-medium text-xs transition-colors"
        >
          Process Another PDF
        </button>

        <a 
          href="${cleanUrl}" 
          download="${cleanFileName}"
          class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-[#0070f3] hover:bg-[#0761d1] text-white font-semibold text-sm shadow-md active:scale-98 transition-all flex items-center justify-center gap-2 text-center"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Download Clean PDF
        </a>
      </div>
    `;

    document.getElementById('btn-pdf-another')?.addEventListener('click', resetPdfToUploadState);
  }

  // Reset UI
  function resetPdfToUploadState() {
    currentPdfFile = null;
    scanPdfResults = null;
    cleanedPdfBlob = null;
    pdfFileInput.value = '';

    pdfStateScan.innerHTML = '';
    pdfStateVerify.innerHTML = '';

    updatePdfStepBadges(1);
    if (pdfErrorBanner) pdfErrorBanner.classList.add('hidden');
    pdfStateUpload.classList.remove('hidden');
    pdfStateScan.classList.add('hidden');
    pdfStateVerify.classList.add('hidden');
  }

  // Update step progress badges UI
  function updatePdfStepBadges(stepNumber) {
    [pdfStep1Badge, pdfStep2Badge, pdfStep3Badge, pdfStep4Badge].forEach((badge, idx) => {
      if (!badge) return;
      const num = idx + 1;
      const circle = badge.querySelector('span');
      if (num <= stepNumber) {
        badge.className = 'flex items-center gap-1.5 text-[#171717] dark:text-white font-semibold';
        if (circle) circle.className = 'w-5 h-5 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] flex items-center justify-center text-[10px]';
      } else {
        badge.className = 'flex items-center gap-1.5 text-[#888888]';
        if (circle) circle.className = 'w-5 h-5 rounded-full bg-[#f5f5f5] dark:bg-[#262626] text-[#888888] flex items-center justify-center text-[10px]';
      }
    });
  }
</script>
