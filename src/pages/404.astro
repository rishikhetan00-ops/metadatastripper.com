---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "404: Page Not Found – Metadata Remover";
const pageDescription = "The page you are looking for does not exist or has been moved. Access free, private, client-side metadata removal tools for images, PDFs, and videos.";
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  <main class="flex-grow flex items-center justify-center max-w-4xl mx-auto px-4 sm:px-6 py-16 sm:py-24 w-full">
    <div class="w-full text-center space-y-8">
      
      <!-- Top Error Pill -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 dark:bg-amber-500/20 border border-amber-500/20 text-xs font-mono text-amber-600 dark:text-amber-400 font-medium">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
        <span>ERROR 404 • PAGE NOT FOUND</span>
      </div>

      <!-- Main Headline -->
      <div class="space-y-3 max-w-2xl mx-auto">
        <h1 class="text-4xl sm:text-6xl font-bold text-[#171717] dark:text-white tracking-tight">
          Lost in Hyperspace?
        </h1>
        <p class="text-base sm:text-lg text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          The page or route you were looking for doesn't exist, has been removed, or moved to another URL.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a 
          href="/" 
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#171717] dark:bg-white text-white dark:text-[#171717] font-semibold text-sm hover:opacity-90 transition-all shadow-md"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 00-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Return to Homepage
        </a>
        <a 
          href="/contact" 
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#262626] text-[#171717] dark:text-white font-medium text-sm hover:bg-[#f0f0f0] dark:hover:bg-[#1f1f1f] transition-all"
        >
          Contact Support
        </a>
      </div>

      <!-- Quick Navigation Grid -->
      <div class="pt-8 border-t border-[#ebebeb] dark:border-[#262626] max-w-3xl mx-auto space-y-4">
        <h2 class="text-xs font-mono uppercase tracking-wider text-[#888888] dark:text-[#a1a1a1]">
          Explore Our Free Privacy Tools
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-left font-sans">
          <a 
            href="/" 
            class="p-5 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#111111] hover:border-[#0070f3] dark:hover:border-[#0070f3] transition-all group"
          >
            <div class="text-2xl mb-2">📷</div>
            <div class="text-sm font-semibold text-[#171717] dark:text-white group-hover:text-[#0070f3] transition-colors">
              Image EXIF Remover
            </div>
            <p class="text-xs text-[#888888] dark:text-[#a1a1a1] mt-1 leading-relaxed">
              Purge GPS coordinates & EXIF metadata from JPG, PNG, WebP photos.
            </p>
          </a>

          <a 
            href="/pdf-metadata-remover" 
            class="p-5 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#111111] hover:border-[#0070f3] dark:hover:border-[#0070f3] transition-all group"
          >
            <div class="text-2xl mb-2">📄</div>
            <div class="text-sm font-semibold text-[#171717] dark:text-white group-hover:text-[#0070f3] transition-colors">
              PDF Metadata Cleaner
            </div>
            <p class="text-xs text-[#888888] dark:text-[#a1a1a1] mt-1 leading-relaxed">
              Remove author info, creation history, and hidden tags from PDF documents.
            </p>
          </a>

          <a 
            href="/video-metadata-remover" 
            class="p-5 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#111111] hover:border-[#0070f3] dark:hover:border-[#0070f3] transition-all group"
          >
            <div class="text-2xl mb-2">🎥</div>
            <div class="text-sm font-semibold text-[#171717] dark:text-white group-hover:text-[#0070f3] transition-colors">
              Video Metadata Remover
            </div>
            <p class="text-xs text-[#888888] dark:text-[#a1a1a1] mt-1 leading-relaxed">
              Strip QuickTime udta, location, and hardware tags from MP4 & MOV videos.
            </p>
          </a>
        </div>
      </div>

    </div>
  </main>
  <Footer />
</Layout>
