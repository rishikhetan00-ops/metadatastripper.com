---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "500: Internal Server Error – Metadata Remover";
const pageDescription = "An unexpected error occurred while processing your request. Rest assured your files remain 100% private and stored locally on your device.";
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  <main class="flex-grow flex items-center justify-center max-w-4xl mx-auto px-4 sm:px-6 py-16 sm:py-24 w-full">
    <div class="w-full text-center space-y-8">
      
      <!-- Top Error Pill -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-500/10 dark:bg-red-500/20 border border-red-500/20 text-xs font-mono text-red-600 dark:text-red-400 font-medium">
        <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
        <span>ERROR 500 • INTERNAL SERVER ERROR</span>
      </div>

      <!-- Main Headline -->
      <div class="space-y-3 max-w-2xl mx-auto">
        <h1 class="text-4xl sm:text-6xl font-bold text-[#171717] dark:text-white tracking-tight">
          Something Went Wrong
        </h1>
        <p class="text-base sm:text-lg text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          An unexpected server error occurred on our end. Don't worry—your files stay 100% private and never leave your browser memory.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <button 
          onclick="window.location.reload()" 
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#171717] dark:bg-white text-white dark:text-[#171717] font-semibold text-sm hover:opacity-90 transition-all shadow-md cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Reload Page
        </button>

        <a 
          href="/" 
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#262626] text-[#171717] dark:text-white font-medium text-sm hover:bg-[#f0f0f0] dark:hover:bg-[#1f1f1f] transition-all"
        >
          Return to Homepage
        </a>
      </div>

      <!-- Quick Navigation Grid -->
      <div class="pt-8 border-t border-[#ebebeb] dark:border-[#262626] max-w-3xl mx-auto space-y-4">
        <h2 class="text-xs font-mono uppercase tracking-wider text-[#888888] dark:text-[#a1a1a1]">
          Or Try One of Our Standalone Metadata Tools
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-left font-sans">
          <a 
            href="/" 
            class="p-5 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#111111] hover:border-[#0070f3] dark:hover:border-[#0070f3] transition-all group"
          >
            <div class="text-2xl mb-2">📷</div>
            <div class="text-sm font-semibold text-[#171717] dark:text-white group-hover:text-[#0070f3] transition-colors">
              Image EXIF Remover
            </div>
            <p class="text-xs text-[#888888] dark:text-[#a1a1a1] mt-1 leading-relaxed">
              Purge GPS coordinates & EXIF metadata from JPG, PNG, WebP photos.
            </p>
          </a>

          <a 
            href="/pdf-metadata-remover" 
            class="p-5 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#111111] hover:border-[#0070f3] dark:hover:border-[#0070f3] transition-all group"
          >
            <div class="text-2xl mb-2">📄</div>
            <div class="text-sm font-semibold text-[#171717] dark:text-white group-hover:text-[#0070f3] transition-colors">
              PDF Metadata Cleaner
            </div>
            <p class="text-xs text-[#888888] dark:text-[#a1a1a1] mt-1 leading-relaxed">
              Remove author info, creation history, and hidden tags from PDF documents.
            </p>
          </a>

          <a 
            href="/video-metadata-remover" 
            class="p-5 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#111111] hover:border-[#0070f3] dark:hover:border-[#0070f3] transition-all group"
          >
            <div class="text-2xl mb-2">🎥</div>
            <div class="text-sm font-semibold text-[#171717] dark:text-white group-hover:text-[#0070f3] transition-colors">
              Video Metadata Remover
            </div>
            <p class="text-xs text-[#888888] dark:text-[#a1a1a1] mt-1 leading-relaxed">
              Strip QuickTime udta, location, and hardware tags from MP4 & MOV videos.
            </p>
          </a>
        </div>
      </div>

    </div>
  </main>
  <Footer />
</Layout>
