---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Contact Us – Metadata Remover";
const pageDescription = "Get in touch with the team at metadatastripper.com for support, feedback, feature requests, or privacy inquiries.";
const pageKeywords = "Contact metadata remover, metadatastripper support, metadata stripper contact, feedback";
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords}>
  <Header />
  <main class="flex-grow max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-12">
    
    <!-- Header Hero -->
    <div class="space-y-4 border-b border-[#ebebeb] dark:border-[#262626] pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0070f3]/10 border border-[#0070f3]/20 text-xs font-mono text-[#0070f3]">
        <span>SUPPORT & FEEDBACK</span>
      </div>
      
      <h1 class="text-3xl sm:text-5xl font-semibold text-[#171717] dark:text-white tracking-tight">
        Contact Us
      </h1>
      
      <p class="text-base sm:text-lg text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
        Have questions, feature requests, or security feedback? We'd love to hear from you.
      </p>
    </div>

    <!-- Contact Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 font-sans">
      
      <!-- Contact Cards -->
      <div class="md:col-span-1 space-y-4">
        
        <div class="p-5 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#111111] space-y-2 card-hairline">
          <div class="text-xs font-mono text-[#0070f3] uppercase font-bold tracking-wider">📧 Email Support</div>
          <p class="text-xs text-[#888888] dark:text-[#a1a1a1]">For general inquiries and technical feedback:</p>
          <a href="mailto:support@metadatastripper.com" class="text-sm font-semibold text-[#171717] dark:text-white hover:text-[#0070f3] dark:hover:text-[#0070f3] block transition-colors">
            support@metadatastripper.com
          </a>
        </div>

        <div class="p-5 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#111111] space-y-2 card-hairline">
          <div class="text-xs font-mono text-[#10b981] uppercase font-bold tracking-wider">🔒 Security & Privacy</div>
          <p class="text-xs text-[#888888] dark:text-[#a1a1a1]">For vulnerability disclosure or privacy concerns:</p>
          <a href="mailto:privacy@metadatastripper.com" class="text-sm font-semibold text-[#171717] dark:text-white hover:text-[#10b981] dark:hover:text-[#10b981] block transition-colors">
            privacy@metadatastripper.com
          </a>
        </div>

        <div class="p-5 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#111111] space-y-2 card-hairline">
          <div class="text-xs font-mono text-[#888888] uppercase font-bold tracking-wider">⚡ Response Time</div>
          <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1]">We generally respond to all inquiries within 24 to 48 hours.</p>
        </div>

      </div>

      <!-- Contact Form -->
      <div class="md:col-span-2 p-6 sm:p-8 rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#111111] space-y-6 card-hairline">
        
        <div>
          <h2 class="text-xl font-semibold text-[#171717] dark:text-white">Send Us a Message</h2>
          <p class="text-xs text-[#888888] dark:text-[#a1a1a1] mt-1 font-mono">Fill out the form below and our team will get back to you.</p>
        </div>

        <form id="contact-form" action="https://formsubmit.co/support@metadatastripper.com" method="POST" class="space-y-4">
          <!-- FormSubmit Configuration -->
          <input type="hidden" name="_subject" id="formsubmit-subject" value="New Contact Message from MetadataStripper.com" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_template" value="table" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label for="contact-name" class="block text-xs font-semibold font-mono text-[#171717] dark:text-white">Your Name</label>
              <input 
                type="text" 
                id="contact-name" 
                name="name" 
                required
                placeholder="Jane Doe"
                class="w-full h-10 px-3 rounded-lg border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#171717] text-xs text-[#171717] dark:text-white focus:outline-none focus:border-[#0070f3] transition-colors"
              />
            </div>
            
            <div class="space-y-1.5">
              <label for="contact-email" class="block text-xs font-semibold font-mono text-[#171717] dark:text-white">Email Address</label>
              <input 
                type="email" 
                id="contact-email" 
                name="email" 
                required
                placeholder="jane@example.com"
                class="w-full h-10 px-3 rounded-lg border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#171717] text-xs text-[#171717] dark:text-white focus:outline-none focus:border-[#0070f3] transition-colors"
              />
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="contact-subject" class="block text-xs font-semibold font-mono text-[#171717] dark:text-white">Subject</label>
            <input 
              type="text" 
              id="contact-subject" 
              name="subject" 
              required
              placeholder="Feature Request / Question"
              class="w-full h-10 px-3 rounded-lg border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#171717] text-xs text-[#171717] dark:text-white focus:outline-none focus:border-[#0070f3] transition-colors"
            />
          </div>

          <div class="space-y-1.5">
            <label for="contact-message" class="block text-xs font-semibold font-mono text-[#171717] dark:text-white">Message</label>
            <textarea 
              id="contact-message" 
              name="message" 
              rows="5"
              required
              placeholder="Describe your question or feedback..."
              class="w-full p-3 rounded-lg border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#171717] text-xs text-[#171717] dark:text-white focus:outline-none focus:border-[#0070f3] transition-colors"
            ></textarea>
          </div>

          <div id="form-feedback" class="hidden p-3 rounded-lg text-xs font-mono"></div>

          <button 
            type="submit" 
            id="submit-btn"
            class="w-full sm:w-auto px-6 py-2.5 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] text-xs font-medium hover:bg-[#333333] dark:hover:bg-[#e5e5e5] transition-colors flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span id="submit-text">Send Message</span>
            <span id="submit-icon">→</span>
          </button>
        </form>

      </div>

    </div>

  </main>
  <Footer />
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const submitText = document.getElementById('submit-text');
  const submitIcon = document.getElementById('submit-icon');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    if (!submitBtn || !feedback || !submitText || !submitIcon) return;

    // Loading state
    submitBtn.disabled = true;
    submitText.textContent = 'Sending...';
    submitIcon.textContent = '⏳';
    feedback.classList.add('hidden');

    const formData = new FormData(form);
    const name = formData.get('name') as string;
    const email = formData.get('email') as string;
    const subject = formData.get('subject') as string;
    const message = formData.get('message') as string;

    try {
      const response = await fetch('https://formsubmit.co/ajax/support@metadatastripper.com', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          name,
          email,
          subject,
          message,
          _subject: `[Contact Form] ${subject || 'New Message'}`,
          _captcha: 'false',
          _template: 'table'
        })
      });

      const data = await response.json();

      if (response.ok && (data.success === 'true' || data.success === true)) {
        feedback.className = 'p-3 rounded-lg text-xs font-mono bg-[#10b981]/10 text-[#10b981] border border-[#10b981]/20';
        feedback.textContent = '✓ Thank you! Your message has been sent directly to support@metadatastripper.com. We will get back to you shortly.';
        form.reset();
      } else {
        throw new Error(data.message || 'Failed to submit form');
      }
    } catch (err) {
      console.error('Contact Form Error:', err);
      feedback.className = 'p-3 rounded-lg text-xs font-mono bg-[#ee0000]/10 text-[#ee0000] border border-[#ee0000]/20';
      feedback.textContent = '✕ Could not submit form automatically. Please email support@metadatastripper.com directly.';
    } finally {
      submitBtn.disabled = false;
      submitText.textContent = 'Send Message';
      submitIcon.textContent = '→';
      feedback.classList.remove('hidden');
    }
  });
</script>
