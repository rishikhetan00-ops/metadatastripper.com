---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Terms & Conditions – Metadata Remover";
const pageDescription = "Read the Terms & Conditions for using metadatastripper.com, a free client-side metadata removal web application.";
const pageKeywords = "Terms and Conditions, Terms of Service, metadata stripper terms, metadatastripper terms";
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords}>
  <Header />
  <main class="flex-grow max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-12">
    
    <!-- Header Hero -->
    <div class="space-y-4 border-b border-[#ebebeb] dark:border-[#262626] pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#fafafa] dark:bg-[#171717] border border-[#ebebeb] dark:border-[#262626] text-xs font-mono text-[#888888] dark:text-[#a1a1a1]">
        <span>LEGAL AGREEMENT</span>
      </div>
      
      <h1 class="text-3xl sm:text-5xl font-semibold text-[#171717] dark:text-white tracking-tight">
        Terms & Conditions
      </h1>
      
      <p class="text-sm sm:text-base text-[#888888] dark:text-[#a1a1a1] font-mono">
        Last Updated: August 2026 • Effective Immediately
      </p>
    </div>

    <!-- Policy Content -->
    <div class="space-y-8 font-sans text-[#171717] dark:text-white">
      
      <section class="space-y-3">
        <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#171717] dark:text-white">
          1. Acceptance of Terms
        </h2>
        <p class="text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          By accessing and using <strong>metadatastripper.com</strong> (the "Service"), you agree to be bound by these Terms & Conditions. If you do not agree with any part of these terms, you must discontinue use of the Service immediately.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#171717] dark:text-white">
          2. Description of Service
        </h2>
        <p class="text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          metadatastripper.com provides free, browser-based tools designed to view and strip metadata (EXIF, IPTC, XMP, PDF Info dictionaries, MP4 container atoms) from image, PDF, and video files. All processing occurs locally within the user's web browser process.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#171717] dark:text-white">
          3. User Responsibilities & Acceptable Use
        </h2>
        <p class="text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          You agree to use the Service solely for lawful purposes. You represent and warrant that:
        </p>
        <ul class="text-sm text-[#4d4d4d] dark:text-[#a1a1a1] space-y-2 list-disc list-inside pl-2">
          <li>You own or possess the necessary rights and permissions for all files processed using the Service.</li>
          <li>You will not use the Service to tamper with digital rights management (DRM), falsify evidence, or engage in fraudulent activities.</li>
          <li>You will not attempt to reverse-engineer, disrupt, or exploit the website infrastructure.</li>
        </ul>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#171717] dark:text-white">
          4. Disclaimer of Warranties
        </h2>
        <div class="p-5 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#111111] space-y-2 text-xs sm:text-sm font-mono text-[#4d4d4d] dark:text-[#a1a1a1]">
          <p>
            THE SERVICE IS PROVIDED ON AN "AS IS" AND "AS AVAILABLE" BASIS WITHOUT WARRANTIES OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, OR NON-INFRINGEMENT.
          </p>
          <p>
            WE DO NOT GUARANTEE THAT THE SERVICE WILL BE UNINTERRUPTED, ERROR-FREE, OR ABSOLUTELY CAPABLE OF PURGING 100% OF PROPRIETARY OR UNKNOWN METADATA FORMATS EMBEDDED BY CUSTOM THIRD-PARTY HARDWARE.
          </p>
        </div>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#171717] dark:text-white">
          5. Limitation of Liability
        </h2>
        <p class="text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          In no event shall metadatastripper.com, its operators, or contributors be liable for any direct, indirect, incidental, special, or consequential damages resulting from the use of or inability to use the Service, including file loss, data corruption, or privacy exposure. Always retain original backups of your files prior to processing.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#171717] dark:text-white">
          6. Intellectual Property
        </h2>
        <p class="text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          The code, design assets, trademarks, logos, and UI components of metadatastripper.com are protected by intellectual property laws. You may not copy, duplicate, or redistribute the source code without explicit written permission.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#171717] dark:text-white">
          7. Governing Law & Modifications
        </h2>
        <p class="text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          We reserve the right to update or modify these Terms & Conditions at any time without prior notice. Continued use of the website following any changes constitutes acceptance of the new terms.
        </p>
      </section>

    </div>

  </main>
  <Footer />
</Layout>
